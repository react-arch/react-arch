{
  "name": "@react-arch/exporters",
  "version": "0.3.0",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gltf": "./src/gltf.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "build": "tsdown"
  },
  "dependencies": {
    "@react-arch/core": "workspace:*",
    "@react-arch/geometry": "workspace:*",
    "@react-arch/shared": "workspace:*"
  },
  "peerDependencies": {
    "three": ">=0.160"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "three": "^0.169.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./gltf": {
        "types": "./dist/gltf.d.ts",
        "default": "./dist/gltf.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/react-arch/react-arch.git",
    "directory": "packages/exporters"
  },
  "license": "MIT"
}
