{
  "name": "react-arch",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative TypeScript platform for creating, editing, rendering, and exporting semantic building models.",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@react-arch/studio-app",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "studio": "pnpm --filter @react-arch/studio-app dev",
    "changeset": "changeset",
    "version": "changeset version",
    "build:libs": "pnpm --filter \"./packages/*\" run build",
    "ci:publish": "pnpm run build:libs && pnpm -r publish --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "oxlint": "^0.15.0",
    "tsdown": "^0.22.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@react-three/fiber>@types/react": "^18.3.12",
      "@react-three/drei>@types/react": "^18.3.12"
    }
  }
}
